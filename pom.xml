<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Intelligent Capital Call & Liquidity Orchestration on Camunda 8 (Java edition).
    One artifact, several entry points (same layout as the former Go module with cmd/*):
      java -jar target/camunda-assetmgmt.jar worker|apiserver|mockses|mockcreditfacility|demodriver
  -->
  <groupId>com.vishworks</groupId>
  <artifactId>camunda-assetmgmt</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Keep method parameter names (the Camunda starter inspects job-worker method parameters). -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Must match the orchestration cluster in docker-compose.yml (camunda/camunda:8.10.9). -->
    <camunda.version>8.10.9</camunda.version>
    <!-- Versions below are the ones Camunda 8.10.9 itself is built/shipped with. -->
    <jackson.version>2.22.4</jackson.version>
    <postgresql.version>42.7.14</postgresql.version>
    <hikaricp.version>7.1.0</hikaricp.version>
    <log4j.version>2.26.1</log4j.version>
    <junit.version>5.13.4</junit.version>
    <!-- The Spring Boot version camunda-spring-boot-starter ${camunda.version} is built against
         (its POM declares org.springframework.boot:spring-boot 4.1.2). -->
    <spring-boot.version>4.1.2</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Imported before the Spring Boot BOM so that the versions this project pins (the ones
           Camunda ${camunda.version} ships with) win over Spring Boot's managed versions. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Camunda Spring Boot Starter: @JobWorker job workers and the CamundaClient bean.
         Brings camunda-client-java ${camunda.version} transitively. -->
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-spring-boot-starter</artifactId>
      <version>${camunda.version}</version>
      <exclusions>
        <!-- Logging stays on Log4j 2 (log4j2.xml); never pull in Logback. -->
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- JSON (replaces Go encoding/json). Same version the Camunda client uses. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- PostgreSQL driver + connection pool (replace github.com/jackc/pgx/v5 and pgxpool). -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
    </dependency>

    <!-- Logging: SLF4J (used by the Camunda client) bound to Log4j 2, formatted like Go's log package. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>camunda-assetmgmt</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <plugin>
        <!-- Self-contained executable jar (Spring Boot repackage; nested jars keep the
             META-INF/spring auto-configuration files of every dependency intact). -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>com.vishworks.assetmgmt.Main</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
