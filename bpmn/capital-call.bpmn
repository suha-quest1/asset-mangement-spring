<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_capital-call" targetNamespace="http://bpmn.io/schema/bpmn" exporter="gen_bpmn.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="capital-call" name="Intelligent Capital Call &amp; Liquidity Orchestration" isExecutable="true">
    <bpmn:startEvent id="Start_Call" name="GP issues capital call">
      <bpmn:outgoing>Flow_Start_Issue</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Issue" name="Issue capital call">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issueCapitalCall" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Issue</bpmn:incoming>
      <bpmn:outgoing>Flow_Issue_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Notify" name="Notify LPs (SES batch)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notifyLPs" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Issue_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Collect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_LPResponses" name="Collect LP responses (one LP Response process per LP)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="lp-response" propagateAllChildVariables="false"/>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="lpResponse"/>
          <zeebe:output source="=lpResponse" target="lpResponse"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Notify_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_Collect_Merge</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=lpList" inputElement="lp" outputCollection="lpResponses" outputElement="=lpResponse"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Boundary_Deadline" name="Hard deadline" attachedToRef="Call_LPResponses">
      <bpmn:outgoing>Flow_Deadline_Finalize</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=callDeadline</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Force" name="GP forces settlement" attachedToRef="Call_LPResponses">
      <bpmn:outgoing>Flow_Force_Finalize</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ForceSettlement"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Cancel" name="GP cancels call" attachedToRef="Call_LPResponses">
      <bpmn:outgoing>Flow_Cancel_Task</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CancelCall"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Finalize" name="Close response window (default outstanding LPs)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finalizeResponses" retries="3"/>
        <zeebe:taskHeaders>
          <zeebe:header key="reason" value="force-settlement"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Force_Finalize</bpmn:incoming>
      <bpmn:outgoing>Flow_Finalize_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FinalizeDeadline" name="Close response window (deadline)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="finalizeResponses" retries="3"/>
        <zeebe:taskHeaders>
          <zeebe:header key="reason" value="hard-deadline"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Deadline_Finalize</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalizeDeadline_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Cancel" name="Mark call cancelled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="markCallCancelled" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cancel_Task</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelTask_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Cancelled" name="Capital call cancelled">
      <bpmn:incoming>Flow_CancelTask_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Responses" name="">
      <bpmn:incoming>Flow_Collect_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Finalize_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_FinalizeDeadline_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_Aggregate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Aggregate" name="Aggregate liquidity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="aggregateLiquidity" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_Aggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_Aggregate_Predict</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Predict" name="Predict LP default risk (ML)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="predictDefaultRisk" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Aggregate_Predict</bpmn:incoming>
      <bpmn:outgoing>Flow_Predict_Portfolio</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Portfolio" name="Score LP portfolio (concentration)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scoreLPPortfolio" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Predict_Portfolio</bpmn:incoming>
      <bpmn:outgoing>Flow_Portfolio_Split</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Split" name="">
      <bpmn:incoming>Flow_Portfolio_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_Gap</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_HighRisk</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_Gap" name="Liquidity gap &gt; 10%?" default="Flow_Gap_No">
      <bpmn:incoming>Flow_Split_Gap</bpmn:incoming>
      <bpmn:outgoing>Flow_Gap_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gap_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Bridge" name="Trigger bridge (credit line drawdown)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triggerBridge" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Gap_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Bridge_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_GapMerge" name="">
      <bpmn:incoming>Flow_Bridge_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Gap_No</bpmn:incoming>
      <bpmn:outgoing>Flow_GapMerge_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_HighRisk" name="High-risk LPs (score &gt; 0.7)?" default="Flow_HighRisk_No">
      <bpmn:incoming>Flow_Split_HighRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_HighRisk_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_HighRisk_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_GPReview" name="GP review per high-risk LP">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=null" target="gpAction"/>
          <zeebe:input source="=null" target="gpName"/>
          <zeebe:input source="=null" target="gpComment"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighRisk_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Sub_Merge</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=highRiskLPs" inputElement="highRiskLp" outputCollection="gpDecisions" outputElement="={lpId: highRiskLp.lpId, riskScore: highRiskLp.riskScore, action: gpAction, gpName: gpName}"/>
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Start_GP" name="">
        <bpmn:outgoing>Flow_GPStart_Escalate</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_Escalate" name="Escalate to GP (Slack alert)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="escalateToGP" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_GPStart_Escalate</bpmn:incoming>
        <bpmn:outgoing>Flow_Escalate_Approval</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="UserTask_GPApproval" name="GP approval gate: waive or enforce">
        <bpmn:extensionElements>
          <zeebe:userTask/>
          <zeebe:formDefinition formId="gp-approval-form"/>
          <zeebe:assignmentDefinition candidateGroups="gp-investment-committee"/>
          <zeebe:priorityDefinition priority="80"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Escalate_Approval</bpmn:incoming>
        <bpmn:outgoing>Flow_Approval_Merge</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="Boundary_GPDecision" name="GP decision via API" attachedToRef="UserTask_GPApproval">
        <bpmn:outgoing>Flow_APIDecision_Merge</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_GPDecision"/>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="Gateway_Decision" name="">
        <bpmn:incoming>Flow_Approval_Merge</bpmn:incoming>
        <bpmn:incoming>Flow_APIDecision_Merge</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_Apply</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_ApplyDecision" name="Apply GP decision (enforcement notice if enforce)">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="applyGPDecision" retries="3"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Merge_Apply</bpmn:incoming>
        <bpmn:outgoing>Flow_Apply_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_GP" name="">
        <bpmn:incoming>Flow_Apply_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_GPStart_Escalate" sourceRef="Start_GP" targetRef="Task_Escalate"/>
      <bpmn:sequenceFlow id="Flow_Escalate_Approval" sourceRef="Task_Escalate" targetRef="UserTask_GPApproval"/>
      <bpmn:sequenceFlow id="Flow_Approval_Merge" sourceRef="UserTask_GPApproval" targetRef="Gateway_Decision"/>
      <bpmn:sequenceFlow id="Flow_APIDecision_Merge" sourceRef="Boundary_GPDecision" targetRef="Gateway_Decision"/>
      <bpmn:sequenceFlow id="Flow_Merge_Apply" sourceRef="Gateway_Decision" targetRef="Task_ApplyDecision"/>
      <bpmn:sequenceFlow id="Flow_Apply_End" sourceRef="Task_ApplyDecision" targetRef="End_GP"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_HighRiskMerge" name="">
      <bpmn:incoming>Flow_Sub_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_HighRisk_No</bpmn:incoming>
      <bpmn:outgoing>Flow_HRMerge_Join</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Join" name="">
      <bpmn:incoming>Flow_GapMerge_Join</bpmn:incoming>
      <bpmn:incoming>Flow_HRMerge_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Settle</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Settle" name="Settle &amp; reconcile (wires + ledger)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="settleAndReconcile" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_Settle</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_Report</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Report" name="Emit liquidity report (PDF + JSON)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="emitLiquidityReport" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Settle_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_Report_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Call" name="Capital call settled &amp; reported">
      <bpmn:incoming>Flow_Report_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Issue" sourceRef="Start_Call" targetRef="Task_Issue"/>
    <bpmn:sequenceFlow id="Flow_Issue_Notify" sourceRef="Task_Issue" targetRef="Task_Notify"/>
    <bpmn:sequenceFlow id="Flow_Notify_Collect" sourceRef="Task_Notify" targetRef="Call_LPResponses"/>
    <bpmn:sequenceFlow id="Flow_Deadline_Finalize" sourceRef="Boundary_Deadline" targetRef="Task_FinalizeDeadline"/>
    <bpmn:sequenceFlow id="Flow_Force_Finalize" sourceRef="Boundary_Force" targetRef="Task_Finalize"/>
    <bpmn:sequenceFlow id="Flow_Cancel_Task" sourceRef="Boundary_Cancel" targetRef="Task_Cancel"/>
    <bpmn:sequenceFlow id="Flow_CancelTask_End" sourceRef="Task_Cancel" targetRef="End_Cancelled"/>
    <bpmn:sequenceFlow id="Flow_Collect_Merge" sourceRef="Call_LPResponses" targetRef="Gateway_Responses"/>
    <bpmn:sequenceFlow id="Flow_Finalize_Merge" sourceRef="Task_Finalize" targetRef="Gateway_Responses"/>
    <bpmn:sequenceFlow id="Flow_FinalizeDeadline_Merge" sourceRef="Task_FinalizeDeadline" targetRef="Gateway_Responses"/>
    <bpmn:sequenceFlow id="Flow_Merge_Aggregate" sourceRef="Gateway_Responses" targetRef="Task_Aggregate"/>
    <bpmn:sequenceFlow id="Flow_Aggregate_Predict" sourceRef="Task_Aggregate" targetRef="Task_Predict"/>
    <bpmn:sequenceFlow id="Flow_Predict_Portfolio" sourceRef="Task_Predict" targetRef="Task_Portfolio"/>
    <bpmn:sequenceFlow id="Flow_Portfolio_Split" sourceRef="Task_Portfolio" targetRef="Gateway_Split"/>
    <bpmn:sequenceFlow id="Flow_Split_Gap" sourceRef="Gateway_Split" targetRef="Gateway_Gap"/>
    <bpmn:sequenceFlow id="Flow_Gap_Yes" name="yes" sourceRef="Gateway_Gap" targetRef="Task_Bridge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=gapPercent &gt; 10</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Bridge_Merge" sourceRef="Task_Bridge" targetRef="Gateway_GapMerge"/>
    <bpmn:sequenceFlow id="Flow_Gap_No" name="no" sourceRef="Gateway_Gap" targetRef="Gateway_GapMerge"/>
    <bpmn:sequenceFlow id="Flow_Split_HighRisk" sourceRef="Gateway_Split" targetRef="Gateway_HighRisk"/>
    <bpmn:sequenceFlow id="Flow_HighRisk_Yes" name="yes" sourceRef="Gateway_HighRisk" targetRef="Sub_GPReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(highRiskLPs) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Sub_Merge" sourceRef="Sub_GPReview" targetRef="Gateway_HighRiskMerge"/>
    <bpmn:sequenceFlow id="Flow_HighRisk_No" name="no" sourceRef="Gateway_HighRisk" targetRef="Gateway_HighRiskMerge"/>
    <bpmn:sequenceFlow id="Flow_GapMerge_Join" sourceRef="Gateway_GapMerge" targetRef="Gateway_Join"/>
    <bpmn:sequenceFlow id="Flow_HRMerge_Join" sourceRef="Gateway_HighRiskMerge" targetRef="Gateway_Join"/>
    <bpmn:sequenceFlow id="Flow_Join_Settle" sourceRef="Gateway_Join" targetRef="Task_Settle"/>
    <bpmn:sequenceFlow id="Flow_Settle_Report" sourceRef="Task_Settle" targetRef="Task_Report"/>
    <bpmn:sequenceFlow id="Flow_Report_End" sourceRef="Task_Report" targetRef="End_Call"/>
  </bpmn:process>
  <bpmn:message id="Message_ForceSettlement" name="forceSettlement">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=callId"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_CancelCall" name="cancelCall">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=callId"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_GPDecision" name="gpDecision">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=callId + &quot;:&quot; + highRiskLp.lpId"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="Diagram_capital-call">
    <bpmndi:BPMNPlane id="Plane_capital-call" bpmnElement="capital-call">
      <bpmndi:BPMNShape id="Start_Call_di" bpmnElement="Start_Call">
        <dc:Bounds x="150" y="282" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="322" width="76" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Issue_di" bpmnElement="Task_Issue">
        <dc:Bounds x="230" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify">
        <dc:Bounds x="380" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_LPResponses_di" bpmnElement="Call_LPResponses">
        <dc:Bounds x="530" y="260" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Deadline_di" bpmnElement="Boundary_Deadline">
        <dc:Bounds x="552" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="490" y="360" width="76" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Force_di" bpmnElement="Boundary_Force">
        <dc:Bounds x="612" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="652" y="360" width="76" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Cancel_di" bpmnElement="Boundary_Cancel">
        <dc:Bounds x="622" y="242" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="210" width="76" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Finalize_di" bpmnElement="Task_Finalize">
        <dc:Bounds x="550" y="410" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FinalizeDeadline_di" bpmnElement="Task_FinalizeDeadline">
        <dc:Bounds x="400" y="410" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cancel_di" bpmnElement="Task_Cancel">
        <dc:Bounds x="700" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancelled_di" bpmnElement="End_Cancelled">
        <dc:Bounds x="850" y="122" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="830" y="162" width="76" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Responses_di" bpmnElement="Gateway_Responses" isMarkerVisible="true">
        <dc:Bounds x="720" y="275" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="329" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Aggregate_di" bpmnElement="Task_Aggregate">
        <dc:Bounds x="820" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Predict_di" bpmnElement="Task_Predict">
        <dc:Bounds x="970" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Portfolio_di" bpmnElement="Task_Portfolio">
        <dc:Bounds x="1120" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split">
        <dc:Bounds x="1270" y="275" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1250" y="329" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Gap_di" bpmnElement="Gateway_Gap" isMarkerVisible="true">
        <dc:Bounds x="1370" y="105" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1350" y="159" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bridge_di" bpmnElement="Task_Bridge">
        <dc:Bounds x="1500" y="90" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GapMerge_di" bpmnElement="Gateway_GapMerge" isMarkerVisible="true">
        <dc:Bounds x="2160" y="105" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2140" y="159" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HighRisk_di" bpmnElement="Gateway_HighRisk" isMarkerVisible="true">
        <dc:Bounds x="1370" y="445" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1350" y="499" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_GPReview_di" bpmnElement="Sub_GPReview" isExpanded="true">
        <dc:Bounds x="1460" y="380" width="660" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_GP_di" bpmnElement="Start_GP">
        <dc:Bounds x="1480" y="452" width="36" height="36"/>
